# انسخي هذا الملف إلى /etc/tltd.env على الخادم، ولا ترفعيه إلى GitHub بعد تعبئته.
SECRET_KEY=ضعي-هنا-مفتاحًا-عشوائيًا-طويلًا
DB_PATH=/var/lib/tltd/tltd.db
TZ_NAME=Asia/Riyadh
BEHIND_PROXY=1
# بعد تشغيل: flask --app app vapid-gen --out /var/lib/tltd/vapid_private.pem
VAPID_PUBLIC=
VAPID_PRIVATE_FILE=/var/lib/tltd/vapid_private.pem
VAPID_SUBJECT=mailto:you@example.com
